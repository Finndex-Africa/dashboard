# Copy to .env and fill in. Never commit .env.
#
# RULE: NEXT_PUBLIC_* is compiled into the browser bundle and is visible to every
# visitor. Only put publishable values here. Secrets go in unprefixed vars, which
# are readable on the server only.

# --- Public (safe to ship to the browser) ---
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_MODE=dashboard
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Stream's client-side key is publishable by design.
NEXT_PUBLIC_STREAM_KEY=

# --- Server-only (never add a NEXT_PUBLIC_ prefix to these) ---
PORT=3030
STREAM_KEY=
STREAM_SECRET=
